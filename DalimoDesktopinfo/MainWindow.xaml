<Window x:Class="DalimoDesktopinfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysInfo" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!-- Контекстное меню -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Обновить" Click="MenuRefresh_Click"/>
            <MenuItem Header="Диагностика" Click="MenuDiagnostics_Click"/>
            <MenuItem Header="Восстановить положение" Click="MenuResetPosition_Click"/>
            <Separator/>
            <MenuItem Header="Настройки" Click="MenuSettings_Click"/>
            <MenuItem Header="О программе" Click="MenuAbout_Click"/>
            <Separator/>
            <MenuItem Header="Выход" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Основной фон (теперь с именем, чтобы менять цвет из кода) -->
    <Border x:Name="MainBorder" Background="#99000000" CornerRadius="8" Padding="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel>
            <!-- Панель для перемещения -->
            <Border Background="#33FFFFFF" CornerRadius="4" Height="20" Margin="0,0,0,10" Cursor="SizeAll"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock Text="Dalimo" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>

            <!-- Строки (добавлены имена для применения настроек) -->
            <Border Margin="0,0,0,2" Cursor="Hand" Background="#00FFFFFF" CornerRadius="4" Padding="3,1" RenderTransformOrigin="0,0.5" MouseEnter="ClickableText_MouseEnter" MouseLeave="ClickableText_MouseLeave" MouseLeftButtonUp="CopyText_Click">
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <TextBlock x:Name="TxtHost" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
            </Border>
            <Border Cursor="Hand" MouseLeftButtonUp="Status_Click" Margin="0,0,0,6" ToolTip="Нажмите, чтобы посмотреть результаты">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="Gray" Margin="1,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Статус" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="TxtUser" FontFamily="Consolas" FontSize="12" Foreground="#EECC00" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtUptime" FontFamily="Consolas" FontSize="12" Foreground="#00FFCC" Margin="0,0,0,10"/>

            <Button x:Name="DiagnosticsButton" Content="Диагностика" Click="Diagnostics_Click" Margin="0,0,0,10" Padding="14,8" MinWidth="150" HorizontalAlignment="Center" Foreground="White" Background="#FF2878D0" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF368CE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#FF1D5FA8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Rectangle Height="1" Fill="#44FFFFFF" Margin="0,0,0,10"/>

            <ItemsControl x:Name="NetworkList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="{Binding NameSize}" FontWeight="Bold" Foreground="{Binding NameColor}" TextWrapping="Wrap"/>
                            <Border Cursor="Hand" Background="#00FFFFFF" CornerRadius="4" Padding="3,1" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" MouseEnter="ClickableText_MouseEnter" MouseLeave="ClickableText_MouseLeave" MouseLeftButtonUp="CopyText_Click">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding Mac}" FontFamily="Consolas" FontSize="{Binding MacSize}" Foreground="{Binding MacColor}"/>
                            </Border>
                            <Border Cursor="Hand" Background="#00FFFFFF" CornerRadius="4" Padding="3,1" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" MouseEnter="ClickableText_MouseEnter" MouseLeave="ClickableText_MouseLeave" MouseLeftButtonUp="CopyText_Click">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding Ip}" FontFamily="Consolas" FontSize="{Binding IpSize}" Foreground="{Binding IpColor}"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="ToastPanel" Visibility="Collapsed" Background="#EE333333" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" MaxWidth="220">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="204"/>
            </Border>
        </StackPanel>
    </Border>
</Window>