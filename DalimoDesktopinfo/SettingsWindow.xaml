<Window x:Class="DalimoDesktopinfo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="500" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Вкладка: Основное -->
            <TabItem Header="Основное">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Host -->
                        <TextBlock Text="Имя ПК:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHostSize" Grid.Row="0" Grid.Column="1" Margin="0,5" Text="14"/>
                        <TextBox x:Name="TxtHostColor" Grid.Row="0" Grid.Column="2" Margin="5,5,0,5" Text="#FFFFFF"/>

                        <!-- User -->
                        <TextBlock Text="Пользователь:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtUserSize" Grid.Row="1" Grid.Column="1" Margin="0,5" Text="12"/>
                        <TextBox x:Name="TxtUserColor" Grid.Row="1" Grid.Column="2" Margin="5,5,0,5" Text="#EECC00"/>

                        <!-- Uptime -->
                        <TextBlock Text="Аптайм:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtUptimeSize" Grid.Row="2" Grid.Column="1" Margin="0,5" Text="12"/>
                        <TextBox x:Name="TxtUptimeColor" Grid.Row="2" Grid.Column="2" Margin="5,5,0,5" Text="#00FFCC"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка: Сеть -->
            <TabItem Header="Сеть">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <TextBlock Text="Имя адаптера:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtNameSize" Grid.Row="0" Grid.Column="1" Margin="0,5" Text="11"/>
                        <TextBox x:Name="TxtNameColor" Grid.Row="0" Grid.Column="2" Margin="5,5,0,5" Text="#55CC77"/>

                        <!-- Mac -->
                        <TextBlock Text="MAC-адрес:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtMacSize" Grid.Row="1" Grid.Column="1" Margin="0,5" Text="11"/>
                        <TextBox x:Name="TxtMacColor" Grid.Row="1" Grid.Column="2" Margin="5,5,0,5" Text="#AAAAAA"/>

                        <!-- Ip -->
                        <TextBlock Text="IP-адрес:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtIpSize" Grid.Row="2" Grid.Column="1" Margin="0,5" Text="11"/>
                        <TextBox x:Name="TxtIpColor" Grid.Row="2" Grid.Column="2" Margin="5,5,0,5" Text="#00FFFF"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка: Фон -->
            <TabItem Header="Фон">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Цвет фона (HEX):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBgColor" Grid.Row="0" Grid.Column="1" Margin="0,5" Text="#000000"/>

                    <TextBlock Text="Прозрачность (0-100):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="SliderOpacity" Minimum="0" Maximum="100" Width="150" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <!-- Добавили Width="40" чтобы текст не прыгал и не вылезал -->
                        <TextBlock x:Name="TxtOpacityValue" Text="60%" Margin="10,0,0,0" Width="40" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="100" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>